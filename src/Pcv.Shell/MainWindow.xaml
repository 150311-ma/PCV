<Window x:Class="Pcv.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PAINCHARNWAV" Height="820" Width="1120" MinHeight="680" MinWidth="940"
        WindowStyle="None" ResizeMode="CanResize" Background="#F6F8FC"
        WindowStartupLocation="CenterScreen" Icon="/assets/pcv.png"
        FontFamily="PingFang SC, MiSans, Microsoft YaHei UI, 微软雅黑" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#131A24" />
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#7A8699" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9AA4B2" />
        </Style>

        <!-- 窗口按钮 -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#4A5563" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#E5484D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航项 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="10,0,10,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#4A5563" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="9" />
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#0E000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1370F3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#0F63DB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#4A5563" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E9F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#C9D8EE" />
                                <Setter TargetName="Shell" Property="Background" Value="#FAFCFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条：默认那根太粗，和这套界面不搭 -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C9D5E6" CornerRadius="4" Width="6"
                                                        HorizontalAlignment="Center" Margin="1,3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E6EDF7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- 列表卡片：软件与框架共用 -->
        <DataTemplate x:Key="FrameworkCardTemplate">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Content="打开" Tag="{Binding Id}" Click="BtnOpenModule_Click"
                            Height="28" Padding="14,0" FontSize="11.5" VerticalAlignment="Center"
                            Margin="0,0,14,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#0F63DB" />
                                <Setter Property="Background" Value="#EAF2FE" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Shell" Property="Background" Value="#DCEAFD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanOpen}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="11" Background="#F1F6FD"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initial}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#1370F3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="2" Margin="13,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#131A24" />
                            <TextBlock Text="{Binding Version}" FontSize="11" Margin="7,2,0,0"
                                       Foreground="#9AA4B2" />
                            <Border Background="{Binding StatePill}" CornerRadius="5" Padding="6,1" Margin="7,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding State}" FontSize="10" Foreground="{Binding StateInk}" />
                            </Border>
                            <Border Background="#FFF4E5" CornerRadius="5" Padding="6,1" Margin="5,0,0,0"
                                    VerticalAlignment="Center" Visibility="{Binding BaseVisibility}">
                                <TextBlock Text="{Binding BaseLabel}" FontSize="10" Foreground="#9A5B00" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="#7A8699"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="3" Content="卸载" Tag="{Binding Id}" Click="BtnUninstall_Click"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Height" Value="26" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="#8A94A3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanUninstall}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border BorderBrush="#DCE5F2" BorderThickness="1" Background="#F6F8FC">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Margin="18,0,12,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/assets/pcv.png" Width="22" Height="22"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="PAINCHARNWAV" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0"
                                   VerticalAlignment="Center" Foreground="#131A24" />
                        <Border Background="#EDF2FA" CornerRadius="6" Padding="6,2" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="LabVersion" Text="1.0.0" FontSize="10" Foreground="#6B7688" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ChromeButton}" Click="BtnMin_Click" ToolTip="最小化">
                            <Rectangle Width="10" Height="1.4" Fill="#4A5563" />
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="BtnMax_Click" ToolTip="最大化">
                            <Rectangle Width="9" Height="9" Stroke="#4A5563" StrokeThickness="1.4"
                                       RadiusX="1" RadiusY="1" />
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="BtnClose_Click" Margin="4,0,4,0"
                                ToolTip="关闭">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#4A5563" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 左导航 -->
                <Border Grid.Row="1" Width="208" HorizontalAlignment="Left" Background="#FBFCFE"
                        BorderBrush="#E9EFF8" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="工作区" Style="{StaticResource SectionLabel}" Margin="22,0,0,8" />

                        <Button x:Name="NavSoftware" Style="{StaticResource NavButton}" Tag="home" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,2 H7 V7 H2 Z M9,2 H14 V7 H9 Z M2,9 H7 V14 H2 Z M9,9 H14 V14 H9 Z"
                                      Fill="#8A94A3" Width="13" Height="13" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="软件" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavInstall" Style="{StaticResource NavButton}" Tag="install" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8,2 V10 M4,7 L8,11 L12,7 M2,13 H14" Stroke="#8A94A3"
                                      StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"
                                      VerticalAlignment="Center" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="安装" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavFrameworks" Style="{StaticResource NavButton}" Tag="frameworks"
                                Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8,2 L14,5 L8,8 L2,5 Z M2,9 L8,12 L14,9 M2,12 L8,15 L14,12"
                                      Stroke="#8A94A3" StrokeThickness="1.4" Width="13" Height="13"
                                      Stretch="Uniform" VerticalAlignment="Center" StrokeLineJoin="Round" />
                                <TextBlock Text="框架" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavCredits" Style="{StaticResource NavButton}" Tag="credits" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8,1.5 A6.5,6.5 0 1 0 8.1,1.5 M8,7 V11 M8,4.4 V4.5"
                                      Stroke="#8A94A3" StrokeThickness="1.5" Width="13" Height="13"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock Text="版权" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#EDF2FA" Margin="20,14,20,14" />

                        <TextBlock Text="拖 .pclpkg 到窗口任意处，直接装。"
                                   FontSize="11" Foreground="#9AA4B2" TextWrapping="Wrap"
                                   LineHeight="17" Margin="22,0,22,0" />
                    </StackPanel>
                </Border>

                <!-- 内容区 -->
                <Grid Grid.Row="1" Margin="208,0,0,0">

                    <ScrollViewer x:Name="ViewHome" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,22,32,28" MaxWidth="880">
                            <TextBlock Text="已安装的软件" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="软件本身不含框架，能力都是向框架要的。" Style="{StaticResource PageSubtitle}"
                                       Margin="0,6,0,20" />

                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="LabSoftwareCount" FontSize="11.5" Foreground="#9AA4B2"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl x:Name="ListSoftware" ItemTemplate="{StaticResource FrameworkCardTemplate}" />
                            <TextBlock x:Name="LabNoSoftware" Text="还没有软件。"
                                       FontSize="12" Foreground="#9AA4B2" Margin="2,6,0,0"
                                       Visibility="Collapsed" />

                            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="想要装点东西？" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#131A24" />
                                    <TextBlock Text="去「安装」那页：挑文件、拖包，或者让 AI 写一个出来。"
                                               FontSize="11.5" Foreground="#7A8699" Margin="0,6,0,12" />
                                    <Button Content="去安装 →" Width="112" HorizontalAlignment="Left"
                                            Style="{StaticResource GhostButton}" Click="BtnOpenAdd_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ViewAdd" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel Margin="32,22,32,28" MaxWidth="880">
                            <TextBlock Text="安装" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="装现成的，或者自己做一个。" Style="{StaticResource PageSubtitle}"
                                       Margin="0,6,0,20" />

                            <Grid x:Name="DropFrame" Height="168" AllowDrop="True">
                                <Border x:Name="DropZone" Background="White" BorderBrush="#D7E3F4"
                                        BorderThickness="1.5" CornerRadius="14">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Data="M8,2 V12 M4,8 L8,12 L12,8 M2,15 H14"
                                              Stroke="#B6C4D8" StrokeThickness="1.8" Width="24" Height="24"
                                              Stretch="Uniform" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LabDropTitle" Text="拖一个 .pclpkg 或构建脚本进来"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#4A5563"
                                                   Margin="0,12,0,0" HorizontalAlignment="Center" />
                                        <TextBlock Text=".pclpkg 直接装；.py / .js / .ps1 会先跑完再自动装"
                                                   FontSize="11.5" Foreground="#9AA4B2" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,16">
                                    <StackPanel>
                                        <TextBlock Text="① 挑一个文件" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#131A24" />
                                        <TextBlock Text="从硬盘里选 .pclpkg，装上。" FontSize="11.5"
                                                   Foreground="#7A8699" TextWrapping="Wrap" Margin="0,6,0,12"
                                                   LineHeight="17" />
                                        <Button Content="选择文件" HorizontalAlignment="Left"
                                                Style="{StaticResource GhostButton}" Click="BtnChooseFile_Click" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,16">
                                    <StackPanel>
                                        <TextBlock Text="② 让 AI 写" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#131A24" />
                                        <TextBlock Text="把提示词贴给 DeepSeek，拿回一段脚本。" FontSize="11.5"
                                                   Foreground="#7A8699" TextWrapping="Wrap" Margin="0,6,0,12"
                                                   LineHeight="17" />
                                        <Button x:Name="BtnMake" Content="复制提示词" HorizontalAlignment="Left"
                                                Style="{StaticResource GhostButton}" Click="BtnMake_Click" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,16">
                                    <StackPanel>
                                        <TextBlock Text="③ 直接跑脚本" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#131A24" />
                                        <TextBlock Text="产物落在隔离目录，跑完自动装上。" FontSize="11.5"
                                                   Foreground="#7A8699" TextWrapping="Wrap" Margin="0,6,0,12"
                                                   LineHeight="17" />
                                        <Button Content="粘一段 Python" HorizontalAlignment="Left"
                                                Style="{StaticResource GhostButton}" Click="BtnPasteScript_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border x:Name="PanCopied" Background="#EEF8F2" BorderBrush="#CFEBDA"
                                    BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,18,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="LabCopied" TextWrapping="Wrap" FontSize="12" Foreground="#1B6B45"
                                           LineHeight="19" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ViewFrameworks" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel Margin="32,22,32,28" MaxWidth="880">
                            <TextBlock Text="框架" Style="{StaticResource PageTitle}" />
                            <TextBlock x:Name="LabFrameworkTitle" Text="提供能力，被软件调用"
                                       Style="{StaticResource PageSubtitle}" Margin="0,6,0,20" />
                            <StackPanel x:Name="PanFrameworks">
                                <ItemsControl x:Name="ListFrameworks" ItemTemplate="{StaticResource FrameworkCardTemplate}" />
                                <!-- 自定义类别：每个类别一个分组，由代码生成，标题用包自己声明的名字 -->
                                <StackPanel x:Name="PanExtraCategories" />
                                <TextBlock x:Name="LabNoFramework" Text="还没有框架。去「安装」那页装一个。"
                                           FontSize="12" Foreground="#9AA4B2" Margin="2,6,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ViewCredits" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel Margin="32,22,32,30" MaxWidth="880">
                            <TextBlock Text="版权与声明" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="这个项目不是凭空来的，说明白比藏着好。" Style="{StaticResource PageSubtitle}"
                                       Margin="0,6,0,20" />

                            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="本项目基于 PCL 修改" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#131A24" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12.5" Margin="0,9,0,0"
                                               Foreground="#4A5563"
                                               Text="PAINCHARNWAV（PCV）是第三方基于 Plain Craft Launcher (PCL) 独立进行的二次创作，与 PCL 官方无关。" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12.5" Margin="0,7,0,0"
                                               Foreground="#4A5563"
