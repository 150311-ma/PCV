<Window x:Class="Pcv.Shell.SecurityAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCV 检测到异常" Height="600" Width="600" MinHeight="460" MinWidth="480"
        WindowStyle="None" ResizeMode="NoResize" Background="{DynamicResource TrmBg}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="{DynamicResource TrmFont}" FontSize="13">

    <Window.Resources>
        <Style x:Key="LocalDanger" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TrmWhite}" />
            <Setter Property="Background" Value="{DynamicResource TrmDanger}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="PCV 检测到异常" FontSize="{DynamicResource TrmTextTitle}"
                       FontWeight="SemiBold" Foreground="{DynamicResource TrmInk}" />
            <TextBlock x:Name="LabSummary" Margin="0,6,0,0" FontSize="{DynamicResource TrmTextMeta}"
                       Foreground="{DynamicResource TrmInkMuted}" TextWrapping="Wrap" LineHeight="18" />
        </StackPanel>

        <!-- 详情 -->
        <Border Grid.Row="1" Margin="0,16,0,0" Background="{DynamicResource TrmSurface}"
                BorderBrush="{DynamicResource TrmHairline}" BorderThickness="1" CornerRadius="13"
                Padding="16,14" ClipToBounds="True">
            <!--
                ScrollViewer 的内容默认按无限宽测量，卡片会撑出去。
                显式绑到容器的实际宽度，卡片才会在窗口里收边。
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="ListIssues" HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </Border>

        <!-- 说明 -->
        <TextBlock Grid.Row="2" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="19"
                   FontSize="{DynamicResource TrmTextHelp}" Foreground="{DynamicResource TrmHelp}"
                   Text="PCV 不会在你背后继续运行这些被改动的东西。确认后 PCV 会立即结束，重新从官方渠道下载一份即可。" />

        <!-- 操作 -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="点「确定」结束 PCV" VerticalAlignment="Center"
                       FontSize="{DynamicResource TrmTextMeta}" Foreground="{DynamicResource TrmMeta}" />
            <Button Content="确定" Style="{StaticResource LocalDanger}" HorizontalAlignment="Right"
                    Click="BtnConfirm_Click" />
        </Grid>
    </Grid>
</Window>
