<Window x:Class="Pcv.Shell.CreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="创作者工具" Height="700" Width="820" MinHeight="560" MinWidth="700"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource TrmBg}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource TrmFont}" FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="LocalGhost" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TrmInkMuted}" />
            <Setter Property="Background" Value="{DynamicResource TrmSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TrmLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LocalPrimary" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TrmAccentInk}" />
            <Setter Property="Background" Value="{DynamicResource TrmAccent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="{DynamicResource TrmTextControl}" />
            <Setter Property="Foreground" Value="{DynamicResource TrmInk}" />
            <Setter Property="Background" Value="{DynamicResource TrmSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TrmLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TrmTextHelp}" />
            <Setter Property="Foreground" Value="{DynamicResource TrmInkMuted}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="22,0,10,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="创作者工具" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TrmInk}" />
                <Border Background="{DynamicResource TrmChip}" CornerRadius="{DynamicResource TrmRadiusSmall}"
                        Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="发自己的模块" FontSize="{DynamicResource TrmTextMeta}"
                               Foreground="{DynamicResource TrmInkMuted}" />
                </Border>
            </StackPanel>
            <Button HorizontalAlignment="Right" Width="38" Height="28" Background="{DynamicResource TrmTransparent}"
                    Cursor="Hand" Click="BtnClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource TrmInkMuted}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource TrmDangerSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,4,22,16">

                <!-- 第 1 步：选模块 -->
                <Border Background="{DynamicResource TrmSurface}" BorderBrush="{DynamicResource TrmHairline}"
                        BorderThickness="1" CornerRadius="{DynamicResource TrmRadius}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="① 选一个做好的模块" FontSize="{DynamicResource TrmTextList}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TrmInk}" />
                        <TextBlock Text="可以选打包好的 .pclpkg，也可以选模块目录（里面有 module.json 的那种）。"
                                   FontSize="{DynamicResource TrmTextMeta}" Foreground="{DynamicResource TrmHelp}"
                                   TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPackage" Style="{StaticResource FieldBox}" IsReadOnly="True"
                                     Foreground="{DynamicResource TrmInkMuted}" />
                            <Button Grid.Column="1" Content="选包…" Style="{StaticResource LocalGhost}"
                                    Margin="8,0,0,0" Click="BtnPickPackage_Click" />
                            <Button Grid.Column="2" Content="选目录…" Style="{StaticResource LocalGhost}"
                                    Margin="8,0,0,0" Click="BtnPickFolder_Click" />
                        </Grid>

                        <!-- 读出模块信息 -->
                        <Border x:Name="PanModule" Visibility="Collapsed" Margin="0,14,0,0"
                                Background="{DynamicResource TrmGroup}" BorderBrush="{DynamicResource TrmHairline}"
                                BorderThickness="1" CornerRadius="{DynamicResource TrmRadiusSmall}" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="{DynamicResource TrmRadius}"
                                            Background="{DynamicResource TrmAccent}" VerticalAlignment="Top">
                                        <TextBlock x:Name="LabIcon" Text="模" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TrmWhite}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="LabModuleName" FontSize="{DynamicResource TrmTextList}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TrmInk}" />
                                            <TextBlock x:Name="LabModuleVersion" FontSize="{DynamicResource TrmTextMeta}"
                                                       Margin="8,2,0,0" Foreground="{DynamicResource TrmMeta}" />
                                        </StackPanel>
                                        <TextBlock x:Name="LabModuleId" FontSize="{DynamicResource TrmTextMeta}"
                                                   Foreground="{DynamicResource TrmHelp}" Margin="0,4,0,0" />
                                        <TextBlock x:Name="LabModuleSummary" FontSize="{DynamicResource TrmTextMeta}"
                                                   Foreground="{DynamicResource TrmHelp}" TextWrapping="Wrap"
                                                   LineHeight="17" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- 模块数字：这套体系的核心 -->
                                <Border Background="{DynamicResource TrmAccentSoft}" CornerRadius="{DynamicResource TrmRadiusSmall}"
                                        Padding="14,11" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="这个模块的数字" FontSize="{DynamicResource TrmTextMeta}"
                                                   Foreground="{DynamicResource TrmAccentChipInk}" />
                                        <TextBlock x:Name="LabModuleCode" Text="PCV-0000-0000-0000"
                                                   FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0"
                                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                                   Foreground="{DynamicResource TrmAccentChipInk}" />
                                        <TextBlock Text="它不是随便编的号：把模块 id、版本和包内容一起算出来的。内容改一个字节，号就变。别人凭这个号就能确认拿到的是你发的那一份。"
                                                   FontSize="{DynamicResource TrmTextMeta}" TextWrapping="Wrap"
                                                   LineHeight="17" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource TrmAccentChipInk}" Opacity="0.85" />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="LabFingerprint" FontSize="{DynamicResource TrmTextMeta}"
                                           Foreground="{DynamicResource TrmMeta}" Margin="0,9,0,0"
                                           TextWrapping="Wrap" FontFamily="Consolas, Cascadia Mono, monospace" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="复制模块数字" Style="{StaticResource LocalGhost}"
                                            Click="BtnCopyCode_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 第 2 步：发到 GitHub -->
                <Border Background="{DynamicResource TrmSurface}" BorderBrush="{DynamicResource TrmHairline}"
                        BorderThickness="1" CornerRadius="{DynamicResource TrmRadius}" Padding="18,16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="② 发到自己的 GitHub 仓库" FontSize="{DynamicResource TrmTextList}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TrmInk}" />
                        <TextBlock Text="模块放在你自己的仓库里，PCV 不存任何文件。仓库会被打上 pcv-module 标记，别人在市场里搜名字就能找到。"
                                   FontSize="{DynamicResource TrmTextMeta}" Foreground="{DynamicResource TrmHelp}"
                                   TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="仓库（owner/name）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtRepo" Style="{StaticResource FieldBox}"
                                         ToolTip="例如 yourname/pcv-my-module" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="分支" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtBranch" Text="main" Style="{StaticResource FieldBox}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="GitHub 访问令牌（只存在这台机器上）" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="TxtToken" Height="32" Padding="10,0" FontSize="{DynamicResource TrmTextControl}"
                                             Background="{DynamicResource TrmSurface}" BorderBrush="{DynamicResource TrmLine}"
                                             BorderThickness="1" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="用已保存的" Style="{StaticResource LocalGhost}"
                                        Margin="8,0,0,0" Click="BtnUseSavedToken_Click" />
                            </Grid>
                            <TextBlock Text="需要一个有 repo 权限的 classic token。它不会写进任何文件、不会上传到别处，只在点上传时用一次。"
                                       FontSize="{DynamicResource TrmTextMeta}" Foreground="{DynamicResource TrmMeta}"
                                       TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="BtnUpload" Content="上传并发布" Style="{StaticResource LocalPrimary}"
                                    Click="BtnUpload_Click" IsEnabled="False" />
                            <Button Content="打开我的令牌页" Style="{StaticResource LocalGhost}" Margin="10,0,0,0"
                                    Click="BtnOpenTokenPage_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 结果 -->
                <Border x:Name="PanResult" Visibility="Collapsed" Margin="0,12,0,0"
                        Background="{DynamicResource TrmOkSoft}" BorderBrush="{DynamicResource TrmOkSoft}"
                        BorderThickness="1" CornerRadius="{DynamicResource TrmRadius}" Padding="18,16">
                    <StackPanel>
                        <TextBlock x:Name="LabResultTitle" Text="发布好了" FontSize="{DynamicResource TrmTextList}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TrmOkInk}" />
                        <TextBlock x:Name="LabResultBody" FontSize="{DynamicResource TrmTextMeta}" TextWrapping="Wrap"
                                   LineHeight="18" Margin="0,7,0,0" Foreground="{DynamicResource TrmOkInk}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="复制分享文案" Style="{StaticResource LocalGhost}" Click="BtnCopyShare_Click" />
                            <Button Content="去市场看看" Style="{StaticResource LocalGhost}" Margin="8,0,0,0"
                                    Click="BtnGoMarket_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部提示 -->
        <Grid Grid.Row="2" Margin="22,0,22,14">
            <TextBlock x:Name="LabHint" FontSize="{DynamicResource TrmTextMeta}" Foreground="{DynamicResource TrmHelp}"
                       TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560"
                       Text="先选模块，再填仓库和令牌。上传只做三件事：传包、写 pcv-module.json、给仓库打标记。" />
            <TextBlock x:Name="LabBusy" Text="" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="{DynamicResource TrmTextMeta}" Foreground="{DynamicResource TrmMeta}" />
        </Grid>
    </Grid>
</Window>
