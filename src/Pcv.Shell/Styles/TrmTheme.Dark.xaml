<!--
  TRM UI 设计令牌 · 深色主题
  来源：Turing-Mirror/TRM-UI  src/trm/styles/tokens.css 的 [data-theme="dark"] 段（MIT）

  key 必须与 TrmTheme.xaml 一一对应：换主题时整份字典被替换，
  少一个 key 那个引用就会静默掉回默认值。tools/check_trm_theme.py 会比对两份。
  形状与字号不随主题变，但这里仍要写全份。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="TrmThemeMarker">dark</sys:String>

    <SolidColorBrush x:Key="TrmBg" Color="#171B22" />
    <SolidColorBrush x:Key="TrmSurface" Color="#1F242D" />
    <SolidColorBrush x:Key="TrmShell" Color="#1F242D" />
    <SolidColorBrush x:Key="TrmWorkspace" Color="#171B22" />
    <SolidColorBrush x:Key="TrmRail" Color="#1E222A" />
    <SolidColorBrush x:Key="TrmGroup" Color="#262B34" />
    <SolidColorBrush x:Key="TrmStage" Color="#1E2837" />
    <SolidColorBrush x:Key="TrmPageBg" Color="#0C0F13" />
    <!-- 与浅色主题同一个理由：模块 Surface 的文字色尚未全部令牌化，
         深色主题下这块画布仍需保持浅色，否则深色字压深色底读不出来。 -->
    <SolidColorBrush x:Key="TrmModulePane" Color="#F4F6F8" />

    <SolidColorBrush x:Key="TrmInk" Color="#E4E9EF" />
    <SolidColorBrush x:Key="TrmInkMuted" Color="#A9B3BE" />
    <SolidColorBrush x:Key="TrmHelp" Color="#828C96" />
    <SolidColorBrush x:Key="TrmMeta" Color="#6E7883" />

    <SolidColorBrush x:Key="TrmHairline" Color="#333A44" />
    <SolidColorBrush x:Key="TrmLine" Color="#414956" />
    <SolidColorBrush x:Key="TrmFocusLine" Color="#5A6270" />

    <SolidColorBrush x:Key="TrmAccent" Color="#4AA3F0" />
    <SolidColorBrush x:Key="TrmAccentHover" Color="#63B0F4" />
    <SolidColorBrush x:Key="TrmAccentInk" Color="#0F1319" />
    <SolidColorBrush x:Key="TrmAccentSoft" Color="#21303F" />
    <SolidColorBrush x:Key="TrmAccentSoftHover" Color="#2A3C4F" />
    <SolidColorBrush x:Key="TrmAccentChipInk" Color="#63B0F4" />

    <SolidColorBrush x:Key="TrmChip" Color="#343A43" />
    <SolidColorBrush x:Key="TrmChipInk" Color="#A9B3BE" />
    <SolidColorBrush x:Key="TrmIconTile" Color="#28313D" />
    <SolidColorBrush x:Key="TrmGloss" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="TrmHoverVeil" Color="#14E4E9EF" />
    <SolidColorBrush x:Key="TrmChromeVeil" Color="#1AE4E9EF" />
    <SolidColorBrush x:Key="TrmWhite" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TrmTransparent" Color="Transparent" />
    <SolidColorBrush x:Key="TrmScrim" Color="#80000000" />

    <SolidColorBrush x:Key="TrmOk" Color="#5CC493" />
    <SolidColorBrush x:Key="TrmOkSoft" Color="#1E332A" />
    <SolidColorBrush x:Key="TrmOkInk" Color="#5CC493" />
    <SolidColorBrush x:Key="TrmWarn" Color="#FF9F0A" />
    <SolidColorBrush x:Key="TrmWarnSoft" Color="#3A2E1C" />
    <SolidColorBrush x:Key="TrmWarnInk" Color="#FFB340" />
    <SolidColorBrush x:Key="TrmDanger" Color="#EC7B69" />
    <SolidColorBrush x:Key="TrmDangerSoft" Color="#3A2626" />
    <SolidColorBrush x:Key="TrmDangerInk" Color="#F18C7D" />
    <SolidColorBrush x:Key="TrmNotify" Color="#FF9F0A" />

    <SolidColorBrush x:Key="TrmArt1" Color="#4AA3F0" />
    <SolidColorBrush x:Key="TrmArt2" Color="#A78BFA" />
    <SolidColorBrush x:Key="TrmArt3" Color="#5CC493" />
    <SolidColorBrush x:Key="TrmArt4" Color="#F2956F" />
    <SolidColorBrush x:Key="TrmArt5" Color="#5BBBD9" />
    <SolidColorBrush x:Key="TrmArt6" Color="#E77BA6" />

    <FontFamily x:Key="TrmFont">PingFang SC, MiSans, Microsoft YaHei UI, 微软雅黑</FontFamily>
    <sys:Double x:Key="TrmTextTitle">25</sys:Double>
    <sys:Double x:Key="TrmTextBlock">15.5</sys:Double>
    <sys:Double x:Key="TrmTextBody">15</sys:Double>
    <sys:Double x:Key="TrmTextList">14</sys:Double>
    <sys:Double x:Key="TrmTextControl">13</sys:Double>
    <sys:Double x:Key="TrmTextHelp">12.5</sys:Double>
    <sys:Double x:Key="TrmTextMeta">11.5</sys:Double>

    <CornerRadius x:Key="TrmRadius">14</CornerRadius>
    <CornerRadius x:Key="TrmRadiusSmall">8</CornerRadius>
    <Thickness x:Key="TrmShellGap">8</Thickness>
    <Thickness x:Key="TrmCardPad">18,16</Thickness>
    <Thickness x:Key="TrmPagePad">32,22,32,28</Thickness>
    <sys:Double x:Key="TrmRailWidth">208</sys:Double>
    <sys:Double x:Key="TrmTitleBarHeight">52</sys:Double>

    <DropShadowEffect x:Key="TrmGlass" x:Shared="False" Color="#000000"
                      Opacity="0.40" BlurRadius="12" ShadowDepth="2" Direction="270" />

</ResourceDictionary>
