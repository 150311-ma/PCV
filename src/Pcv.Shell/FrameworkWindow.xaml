<Window x:Class="Pcv.Shell.FrameworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="框架" Height="560" Width="760" MinHeight="380" MinWidth="520"
        WindowStyle="None" ResizeMode="CanResize" Background="#F3F6FB"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        FontFamily="PingFang SC, MiSans, Microsoft YaHei UI, 微软雅黑" FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="18,0,10,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="8" Background="{DynamicResource ColorBrush3}">
                    <TextBlock x:Name="LabMark" Text="P" Foreground="White" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="LabTitle" Text="框架" FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0"
                           VerticalAlignment="Center" Foreground="#343D4A" />
            </StackPanel>

            <Button Grid.Column="1" Width="42" Height="30" Background="Transparent" Cursor="Hand"
                    Click="BtnClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#5B6472" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 框架自己的界面塞这里；没有界面的框架显示一段说明 -->
        <Border Grid.Row="1" Background="White" CornerRadius="14" Margin="16,0,16,0" Padding="22,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="Host" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Padding="20,0">
            <TextBlock x:Name="LabFooter" VerticalAlignment="Center" FontSize="11.5" Foreground="#8A94A3"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
