<Application x:Class="Pcv.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- 主题模块起来之前/之后的兜底令牌，和 PCL 的令牌名保持一致 -->
        <SolidColorBrush x:Key="ColorBrush1" Color="#343D4A" />
        <SolidColorBrush x:Key="ColorBrush2" Color="#0B5BCB" />
        <SolidColorBrush x:Key="ColorBrush3" Color="#1370F3" />
        <SolidColorBrush x:Key="ColorBrush4" Color="#4890F5" />
        <SolidColorBrush x:Key="ColorBrush5" Color="#96C0F9" />
        <SolidColorBrush x:Key="ColorBrush6" Color="#D5E6FD" />
        <SolidColorBrush x:Key="ColorBrush7" Color="#E0EAFD" />
        <SolidColorBrush x:Key="ColorBrush8" Color="#EAF2FE" />
        <SolidColorBrush x:Key="ColorBrushGray2" Color="#737373" />
        <SolidColorBrush x:Key="ColorBrushGray3" Color="#8C8C8C" />
        <SolidColorBrush x:Key="ColorBrushGray5" Color="#CCCCCC" />
        <SolidColorBrush x:Key="ColorBrushGray6" Color="#EBEBEB" />
        <SolidColorBrush x:Key="ColorBrushGray7" Color="#F0F0F0" />
        <SolidColorBrush x:Key="ColorBrushGray8" Color="#F5F5F5" />

        <!-- 细滚动条：全局只放一份，主窗口和自检窗口共用。
             放在 Window.Resources 里的话，第二个窗口就得再抄一遍。 -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C9D5E6" CornerRadius="4" Width="6"
                                                        HorizontalAlignment="Center" Margin="1,3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
    </Application.Resources>
</Application>
